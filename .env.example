# URL of Backrest as reachable from this container, e.g. the container name in the same Docker network
# required
#BACKREST_MCP_BACKREST_URL=http://backrest:9898

# Backrest user for HTTP basic auth; leave username and password empty if authentication is disabled in Backrest
# optional, default=
#BACKREST_MCP_BACKREST_USERNAME=claude

# Password of that user, required together with BACKREST_MCP_BACKREST_USERNAME
# optional, default=
#BACKREST_MCP_BACKREST_PASSWORD=secret

# Timeout of a request against Backrest in milliseconds
# optional, default=60000
#BACKREST_MCP_BACKREST_TIMEOUT=60000

# Public URL of Backrest used for download links handed out by get_download_url
# optional, default=BACKREST_MCP_BACKREST_URL
#BACKREST_MCP_BACKREST_PUBLIC_URL=https://backrest.example.com

# Address the HTTP server listens on
# optional, default=0.0.0.0
#BACKREST_MCP_SERVER_HOST=0.0.0.0

# Port the HTTP server listens on
# optional, default=3000
#BACKREST_MCP_SERVER_PORT=3000

# Log level of the HTTP server (fatal, error, warn, info, debug, trace, silent)
# optional, default=info
#BACKREST_MCP_SERVER_LOG_LEVEL=info

# Path of the MCP endpoint
# optional, default=/mcp
#BACKREST_MCP_PATH=/mcp

# Only expose read-only tools
# optional, default=true
#BACKREST_MCP_READ_ONLY=true

# Comma separated tool names to keep, "*" as wildcard; empty keeps all
# optional, default=
#BACKREST_MCP_TOOLS_ALLOW=get_*,list_*

# Comma separated tool names to remove, "*" as wildcard
# optional, default=
#BACKREST_MCP_TOOLS_DENY=run_command,remove_repo

# Replace repository passwords, restic environment values and hook tokens with ******** in returned configs
# optional, default=true
#BACKREST_MCP_MASK_SECRETS=true

# Bearer token required on the MCP endpoint, empty disables the check
# optional, default=
#BACKREST_MCP_AUTH_TOKEN=a-long-random-secret
